bongSlanhOun "jea reang rohot?";

akthe image_width = "256";
akthe image_height = "256";
akthe i = 0;
akthe j = 0;

akthe y = image_width + " " + image_height;
jongyeytha y;

nvpeldae (j < 256) {
  j = j + 1;
  nvpeldae (i < 256) {
    akthe r = i / 256.0 - 1.0;
    akthe g = j / 256.0 - 1.0;
    akthe b = 0;
    
    r = r * -1;
    g = g * -1;
    b = b * -1;
    
    ir = 255 * r;
    ig = 255 * g;
    ib = 255 * b;

    jongyeytha ir; 

    i = i + 1;
  }
}
